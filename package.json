{
  "name": "job-lens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "collect:index": "node scripts/collect-public-index.mjs",
    "collect:index:codex-live": "node scripts/collect-public-index.mjs --provider codex --auto-loop",
    "collect:index:worker": "node scripts/run-public-index-worker.mjs",
    "build:index-site": "node scripts/index-to-site-jobs.mjs",
    "merge:pipelines": "node scripts/merge-job-pipelines.mjs",
    "score:v2": "python3 scripts/score-jobs-v2.py",
    "test:matching": "PYTHONPATH=. python3 tests/test_matching_v2.py",
    "test:unit": "node --test tests/job-index.test.mjs tests/pipeline-integration.test.mjs tests/rendered-html.test.mjs && npm run test:matching",
    "test:all": "npm run test:unit && npm run build",
    "test:collector": "node --test tests/job-index.test.mjs",
    "validate:data": "node scripts/validate-site-jobs.mjs",
    "ocr:score": "python3 scripts/ocr-and-score.py",
    "ocr:pipeline": "python3 scripts/run-ocr-pipeline.py",
    "prepare:sites": "node scripts/prepare-sites-dist.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
